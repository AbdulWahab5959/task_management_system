# Laravel API base URL used by the React frontend.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_REVERB_APP_KEY=launchstack-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Hosted Stripe Checkout is created by Laravel, so this frontend does not need
# a Stripe publishable key for the redirect flow. Add this placeholder only if
# you later build Stripe Elements or embedded checkout in React.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
