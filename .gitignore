# Local environment and dependency files
.env
.env.*
!.env.example
backend/vendor/
frontend/node_modules/
frontend/dist/

# Runtime and generated application files
backend/storage/logs/*.log
backend/storage/framework/cache/data/
backend/storage/framework/sessions/
backend/storage/framework/views/

# Documentation source/output remains local, like environment files.
*.md
*.pdf
output/
tmp/pdfs/
.clinerules
.github/copilot-instructions.md

# Shared engineering policy and task history; other local Markdown stays ignored.
!/AGENTS.md
!/backend/AGENTS.md
!/frontend/AGENTS.md
!/.github/copilot-instructions.md
!/README.md
!/ROADMAP.md
!/PROGRESS.md
!/docs/agentic/**/*.md
